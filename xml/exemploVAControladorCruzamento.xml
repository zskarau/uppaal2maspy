			<label kind="assignment" x="136" y="0">aguardar = 0</label>
			<nail x="195" y="110"/>
			<nail x="195" y="25"/>
		</transition>
		<transition id="id13">
			<source ref="id10"/>
			<target ref="id10"/>
			<label kind="assignment" x="-25" y="144">aguardar++</label>
			<nail x="-8" y="110"/>
			<nail x="-8" y="153"/>
