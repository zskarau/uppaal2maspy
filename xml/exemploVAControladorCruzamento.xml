<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE nta PUBLIC '-//Uppaal Team//DTD Flat System 1.6//EN' 'http://www.it.uu.se/research/group/darts/uppaal/flat-1_6.dtd'>
<nta>
	<declaration>// Place global declarations here.
chan livre, longe, proximo, ocupado;</declaration>
	<template>
		<name>Controlador</name>
		<location id="id0" x="-93" y="-34">
			<name x="-103" y="-68">Idle</name>
		</location>
		<location id="id1" x="25" y="-34">
			<name x="0" y="-68">Livre</name>
		</location>
		<location id="id2" x="127" y="-34">
			<name x="119" y="-68">Ocupado</name>
		</location>
		<init ref="id0"/>
		<transition id="id3">
			<source ref="id1"/>
			<target ref="id0"/>
			<label kind="synchronisation" x="-59" y="17">longe?</label>
			<nail x="-34" y="17"/>
		</transition>
		<transition id="id4">
			<source ref="id2"/>
			<target ref="id1"/>
