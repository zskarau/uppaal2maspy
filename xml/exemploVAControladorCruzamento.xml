		<transition id="id6">
			<source ref="id0"/>
			<target ref="id1"/>
			<label kind="synchronisation" x="-68" y="-51">proximo?</label>
		</transition>
	</template>
	<template>
		<name x="5" y="5">VA</name>
		<declaration>// Place local declarations here.
int aguardar= 0;</declaration>
		<location id="id7" x="-17" y="-68">
			<name x="-35" y="-102">Longe</name>
		</location>
		<location id="id8" x="-17" y="25">
			<name x="-43" y="-9">NoCruzamento</name>
		</location>
		<location id="id9" x="-85" y="110">
			<name x="-136" y="85">Livre</name>
		</location>
		<location id="id10" x="51" y="110">
			<name x="59" y="85">Ocupado</name>
		</location>
		<location id="id11" x="-85" y="170">
			<name x="-85" y="178">Cruzando</name>
		</location>
		<init ref="id7"/>
